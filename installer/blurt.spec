# PyInstaller's recipe for Blurt (a Python file PyInstaller reads). Build with
# tools\build.py, which runs this and then checks the result.
#
# One folder, not one file: dist\Blurt\Blurt.exe plus _internal\ (starts fast, one
# process in Task Manager, and looks less like malware than an exe that unpacks
# itself into Temp). No console: printed lines go to logs\app.log (app/log.py).
# No UPX packing: packed exes get flagged by antivirus far more often.

import sys
from pathlib import Path

from PyInstaller.utils.win32.versioninfo import (
    FixedFileInfo, StringFileInfo, StringStruct, StringTable, VarFileInfo, VarStruct, VSVersionInfo,
)

ROOT = Path(SPECPATH).parent  # noqa: F821 (SPECPATH is set by PyInstaller)
sys.path.insert(0, str(ROOT))
from app.version import VERSION  # noqa: E402

NAME = "Blurt"
numbers = tuple(int(part) for part in VERSION.split(".")) + (0,)

# Properties > Details on Blurt.exe. A named, versioned exe looks less suspicious to antivirus.
version_info = VSVersionInfo(
    ffi=FixedFileInfo(filevers=numbers, prodvers=numbers),
    kids=[
        StringFileInfo([StringTable("040904B0", [
            StringStruct("CompanyName", "Blurt"),
            StringStruct("FileDescription", "Blurt voice dictation"),
            StringStruct("FileVersion", VERSION),
            StringStruct("InternalName", NAME),
            StringStruct("OriginalFilename", f"{NAME}.exe"),
            StringStruct("ProductName", "Blurt"),
            StringStruct("ProductVersion", VERSION),
        ])]),
        VarFileInfo([VarStruct("Translation", [0x0409, 0x04B0])]),
    ],
)

a = Analysis(  # noqa: F821
    [str(ROOT / "main.py")],
    pathex=[str(ROOT)],
    datas=[
        (str(ROOT / "prompts" / "cleanup.txt"), "prompts"),
        (str(ROOT / "config.example.json"), "."),
        (str(ROOT / "dictionary.example.txt"), "."),
    ],
    # Smart paste's UI Automation wrapper: generated by tools\build.py, imported by
    # app/focus.py only at runtime, so PyInstaller has to be told about it.
    hiddenimports=["comtypes.gen.UIAutomationClient"],
    excludes=["tkinter"],
)

# Qt parts Blurt never uses (27 MB): the software OpenGL fallback (everything is painted
# with QPainter, no OpenGL) and Qt's own translations (Blurt's text is its own).
UNUSED = ("PySide6/opengl32sw.dll", "PySide6/translations/")


def used(entry):
    return not entry[0].replace("\\", "/").startswith(UNUSED)


a.binaries = [entry for entry in a.binaries if used(entry)]
a.datas = [entry for entry in a.datas if used(entry)]
pyz = PYZ(a.pure)  # noqa: F821
exe = EXE(  # noqa: F821
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name=NAME,
    console=False,
    icon=str(ROOT / "installer" / "blurt.ico"),
    version=version_info,
    upx=False,
)
coll = COLLECT(exe, a.binaries, a.datas, upx=False, name=NAME)  # noqa: F821
